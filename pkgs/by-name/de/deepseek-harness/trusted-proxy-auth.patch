diff --git a/packages/client/connection/src/trusted-proxy-auth.ts b/packages/client/connection/src/trusted-proxy-auth.ts
new file mode 100644
index 0000000..761c00c
--- /dev/null
+++ b/packages/client/connection/src/trusted-proxy-auth.ts
@@ -0,0 +1,72 @@
+/** Per-request authentication for deployments with an authenticating reverse proxy. */
+
+import { timingSafeEqual } from 'node:crypto'
+import { readFile } from 'node:fs/promises'
+import { isAbsolute } from 'node:path'
+import { isTrustedApiRequest } from './api-request-trust.ts'
+import type { ConnectionIndexRequest, ConnectionIndexResponse, ConnectionTrustRequest } from './rpc.ts'
+
+const PROXY_HEADER = 'x-dsh-proxy-secret'
+const SECRET_PATTERN = /^[a-f0-9]{64}$/u
+
+/** Exclusive proxy authentication: browser cookies and launch tokens grant no access. */
+export class TrustedProxyAuth {
+  private constructor(
+    private readonly secret: Buffer,
+    private readonly trustedHosts: readonly string[],
+  ) {}
+
+  /**
+   * Read a 256-bit lowercase hex key once at activation; malformed or unreadable files fail load.
+   * @param filename - absolute path to a private file, optionally ending in one newline.
+   * @param trustedHosts - public authorities accepted by the browser-trust fence.
+   * @returns an authentication owner that never mints browser credentials.
+   */
+  static async create(filename: string, trustedHosts: readonly string[]): Promise<TrustedProxyAuth> {
+    if (!isAbsolute(filename)) {
+      throw new Error('client-connection: trustedProxySecretFile must be an absolute path')
+    }
+    const text = (await readFile(filename, 'utf8')).replace(/\r?\n$/u, '')
+    if (text.length !== 64 || !SECRET_PATTERN.test(text)) {
+      throw new Error('client-connection: trustedProxySecretFile must contain exactly 64 lowercase hex characters')
+    }
+    return new TrustedProxyAuth(Buffer.from(text, 'ascii'), trustedHosts)
+  }
+
+  /**
+   * Return a clean application URL without a local authentication token.
+   * @param baseUrl - browser URL whose authority and mount are preserved.
+   * @returns the URL with any token query removed.
+   */
+  authenticatedUrl(baseUrl: string): string {
+    const url = new URL(baseUrl)
+    url.searchParams.delete('token')
+    return url.href
+  }
+
+  /**
+   * Check browser trust and the proxy credential before serving an index.
+   * @param req - incoming index request.
+   * @param res - response owned when this method returns false.
+   * @returns true only for a trusted request carrying the proxy key; never sets cookies.
+   */
+  authorizeIndex(req: ConnectionIndexRequest, res: ConnectionIndexResponse, secure = false): boolean {
+    const status = !isTrustedApiRequest(req, this.trustedHosts, undefined, secure ? 'https:' : 'http:') ? 403 : this.isAuthenticated(req) ? 200 : 401
+    if (status === 200) return true
+    res.writeHead(status, { 'cache-control': 'no-store', 'content-type': 'text/plain; charset=utf-8' })
+    res.end(req.method === 'HEAD' ? undefined : status === 403 ? 'forbidden\n' : 'unauthorized\n')
+    return false
+  }
+
+  /**
+   * Check the private proxy header in constant time after validating its fixed wire length.
+   * @param request - headers supplied by the authenticating proxy; duplicate values are refused.
+   * @returns true only for the configured proxy key, irrespective of cookies or query tokens.
+   */
+  isAuthenticated(request: ConnectionTrustRequest): boolean {
+    const headers = request.headers
+    const value = headers instanceof Headers ? headers.get(PROXY_HEADER) : headers[PROXY_HEADER]
+    if (typeof value !== 'string' || value.length !== 64 || !SECRET_PATTERN.test(value)) return false
+    return timingSafeEqual(Buffer.from(value, 'ascii'), this.secret)
+  }
+}
diff --git a/packages/client/connection/tests/trusted-proxy-auth.host.spec.ts b/packages/client/connection/tests/trusted-proxy-auth.host.spec.ts
new file mode 100644
index 0000000..a55f5c9
--- /dev/null
+++ b/packages/client/connection/tests/trusted-proxy-auth.host.spec.ts
@@ -0,0 +1,108 @@
+/** Exclusive proxy authentication and the browser-trust checks for index requests. */
+
+import { mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { TrustedProxyAuth } from '../src/trusted-proxy-auth.ts'
+import type { ConnectionIndexRequest, ConnectionIndexResponse } from '../src/rpc.ts'
+
+const KEY = '0123456789abcdef'.repeat(4)
+const AUTHORITY = 'app.example:9162'
+const roots: string[] = []
+
+afterEach(async () => {
+  await Promise.all(roots.splice(0).map(root => rm(root, { recursive: true, force: true })))
+})
+
+async function keyFile(contents = KEY): Promise<string> {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-proxy-auth-'))
+  roots.push(root)
+  const filename = join(root, 'key')
+  await writeFile(filename, contents, { mode: 0o600 })
+  return filename
+}
+
+function response() {
+  const state: { status?: number; headers?: Readonly<Record<string, string>> | undefined; body?: string | undefined } = {}
+  const value: ConnectionIndexResponse = {
+    writeHead(status, headers) {
+      state.status = status
+      state.headers = headers
+    },
+    end(body) { state.body = body },
+  }
+  return { value, state }
+}
+
+function request(headers: Record<string, string | string[]> = {}): ConnectionIndexRequest {
+  return { method: 'GET', url: '/', headers: { host: AUTHORITY, ...headers } }
+}
+
+describe('trusted proxy authentication', () => {
+  it('accepts a private header but never issues browser credentials', async () => {
+    const auth = await TrustedProxyAuth.create(await keyFile(KEY + '\n'), [AUTHORITY])
+    const res = response()
+    expect(auth.authorizeIndex(request({ 'x-dsh-proxy-secret': KEY }), res.value)).toBe(true)
+    expect(res.state).toEqual({})
+    expect(auth.isAuthenticated({ headers: new Headers({ 'X-Dsh-Proxy-Secret': KEY }) })).toBe(true)
+    expect(auth.authenticatedUrl(`https://${AUTHORITY}/dsh/?token=old`)).toBe(`https://${AUTHORITY}/dsh/`)
+  })
+
+  it('rejects missing, wrong, malformed, and duplicate credentials without a cookie fallback', async () => {
+    const auth = await TrustedProxyAuth.create(await keyFile(), [AUTHORITY])
+    for (const value of [undefined, '', 'f'.repeat(64), KEY + '\n', KEY.toUpperCase(), [KEY, KEY], `${KEY}, ${KEY}`]) {
+      const req = { ...request({ cookie: 'dsh-auth-legacy=value', ...(value === undefined ? {} : { 'x-dsh-proxy-secret': value }) }), url: '/?token=legacy' }
+      const res = response()
+      expect(auth.isAuthenticated(req)).toBe(false)
+      expect(auth.authorizeIndex(req, res.value)).toBe(false)
+      expect(res.state).toMatchObject({ status: 401, body: 'unauthorized\n' })
+      expect(res.state.headers?.['set-cookie']).toBeUndefined()
+    }
+    expect(auth.isAuthenticated({ headers: new Headers() })).toBe(false)
+  })
+
+  it('keeps Host, Origin, and Fetch Metadata checks even with the correct proxy key', async () => {
+    const auth = await TrustedProxyAuth.create(await keyFile(), [AUTHORITY])
+    for (const extra of [{ host: 'attacker.example' }, { origin: 'https://attacker.example' },
+      { origin: 'null' }, { 'sec-fetch-site': 'cross-site' }]) {
+      const res = response()
+      expect(auth.authorizeIndex(request({ 'x-dsh-proxy-secret': KEY, ...extra }), res.value)).toBe(false)
+      expect(res.state.status).toBe(403)
+    }
+    const res = response()
+    expect(auth.authorizeIndex(request({ 'x-dsh-proxy-secret': KEY, origin: `https://${AUTHORITY}` }), res.value)).toBe(true)
+    const head = { ...request(), method: 'HEAD' }
+    expect(auth.authorizeIndex(head, res.value)).toBe(false)
+    expect(res.state).toMatchObject({ status: 401, body: undefined })
+  })
+
+  it('uses the TLS listener scheme for index authority checks', async () => {
+    const auth = await TrustedProxyAuth.create(await keyFile(), ['app.example:443'])
+    const res = response()
+    expect(auth.authorizeIndex(request({ host: 'app.example', origin: 'https://app.example', 'x-dsh-proxy-secret': KEY }), res.value, true)).toBe(true)
+    expect(res.state).toEqual({})
+  })
+
+  it('fails activation for absent, relative, empty, short, or malformed key files', async () => {
+    await expect(TrustedProxyAuth.create('relative-key', [])).rejects.toThrow('absolute path')
+    const missing = await keyFile()
+    await rm(missing)
+    await expect(TrustedProxyAuth.create(missing, [])).rejects.toThrow()
+    for (const value of ['', 'a'.repeat(63), 'g'.repeat(64), KEY + '\n\n', ' ' + KEY]) {
+      await expect(TrustedProxyAuth.create(await keyFile(value), [])).rejects.toThrow('64 lowercase hex')
+    }
+  })
+
+  it('loads a key once and uses the rotated file only on a new activation', async () => {
+    const filename = await keyFile(KEY + '\r\n')
+    const first = await TrustedProxyAuth.create(filename, [AUTHORITY])
+    const rotated = 'f'.repeat(64)
+    await writeFile(filename, rotated)
+    const second = await TrustedProxyAuth.create(filename, [AUTHORITY])
+    expect(first.isAuthenticated(request({ 'x-dsh-proxy-secret': KEY }))).toBe(true)
+    expect(first.isAuthenticated(request({ 'x-dsh-proxy-secret': rotated }))).toBe(false)
+    expect(second.isAuthenticated(request({ 'x-dsh-proxy-secret': KEY }))).toBe(false)
+    expect(second.isAuthenticated(request({ 'x-dsh-proxy-secret': rotated }))).toBe(true)
+  })
+})
